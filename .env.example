# Copy to .env.local. Firebase web config is public; Firestore owner rules provide privacy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# GitHub repository deployment: /the-lock-in/ ; custom/root deployment: /
VITE_BASE_PATH=/the-lock-in/
