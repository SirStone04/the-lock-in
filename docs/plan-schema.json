{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/the-lock-in/weekly-plan-v1",
  "title": "THE LOCK-IN weekly plan v1",
  "description": "Runtime validation additionally checks real dates, Sunday/Saturday boundaries, task dates inside the week and unique IDs across all arrays.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "weekStart", "weekEnd", "goals", "dailyTasks"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "weekStart": {
      "type": "string",
      "format": "date"
    },
    "weekEnd": {
      "type": "string",
      "format": "date"
    },
    "goals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "dailyTasks": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "recurringRoutines": {
      "type": "array",
      "maxItems": 50,
      "default": [],
      "items": {
        "$ref": "#/$defs/routine"
      }
    },
    "workCommitments": {
      "type": "array",
      "maxItems": 14,
      "default": [],
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "recoveryRecommendations": {
      "type": "array",
      "maxItems": 20,
      "default": [],
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 10000,
      "default": ""
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "priority",
        "date",
        "plannedMinutes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": [
            "Faith",
            "Education",
            "Employment",
            "Fitness",
            "Finances",
            "Nutrition",
            "Skincare",
            "Maintenance",
            "Recovery"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Importance: 3 highest"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "scheduledTime": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "plannedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "travelMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "target": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        },
        "fixed": {
          "type": "boolean"
        }
      }
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "priority",
        "days",
        "plannedMinutes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": [
            "Faith",
            "Education",
            "Employment",
            "Fitness",
            "Finances",
            "Nutrition",
            "Skincare",
            "Maintenance",
            "Recovery"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Importance: 3 highest"
        },
        "scheduledTime": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "plannedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "travelMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "target": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        },
        "fixed": {
          "type": "boolean"
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "priority",
        "date",
        "plannedMinutes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "const": "Employment"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Importance: 3 highest"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "scheduledTime": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "plannedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "travelMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "target": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        },
        "fixed": {
          "type": "boolean"
        }
      }
    }
  }
}
